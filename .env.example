# Codex Environment Configuration
# Copy this file to .env and update values for your environment
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   docker compose up

# =============================================================================
# REQUIRED - Must be set for production
# =============================================================================

# Secret key for session signing and encryption
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# =============================================================================
# OPTIONAL - Have sensible defaults
# =============================================================================

# Database configuration for the system database (users, workspaces,
# permissions, tasks). SQLite is the default and is fine for single-user
# installs. PostgreSQL is required once Organizations / shared workspaces are
# in use (see docs/postgres.md) - install with `pip install -e ".[postgres]"`
# or use docker-compose.postgres.yml.
# Docker Compose default:
#   DATABASE_URL=sqlite:////app/data/codex_system.db
# Local dev without Docker:
#   DATABASE_URL=sqlite:///./data/codex_system.db
# PostgreSQL:
#   DATABASE_URL=postgresql://codex:codex@localhost:5432/codex_system
DATABASE_URL=sqlite:///./data/codex_system.db

# Postgres connection pool sizing (Postgres only, ignored for SQLite)
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=20
# DATABASE_POOL_RECYCLE=1800

# Debug mode (set to true only for development)
DEBUG=false

# Logging configuration
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

LOG_FORMAT=colored  # Options: colored, json, plain

# Plugin directory configuration
# Default: ./plugins (relative to repository root)
# In Docker: /app/plugins (mounted from ./plugins)
# CODEX_PLUGINS_DIR=/app/plugins
